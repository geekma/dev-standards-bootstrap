#!/usr/bin/env bash
# pre-commit — 溯源自动章 + staged 门禁（v3.40.0，CHG-044 / FU-106①）；盖章后 index 回填（v3.61.2，CHG-079 REQ-1017）
# 盖章幂等（stamp-provenance.sh 写前删旧块，重跑=覆盖替换）。fail 边界：
#   · 无活跃变更 / stamp 脚本缺失 → 显式提示并跳过（fail-open，gate staged 对
#     代码路径仍拦；溯源缺口由 gate stop 与审计 A20/A21 兜底拦截）；
#   · stamp 执行失败（--all 或 --bug）→ exit 1 阻断 commit（fail-closed，
#     对齐「缺章不可交付」）。
# bug_ref 提取按治理记录级解析（压平→按顶层对象切分→按 change_id 选中），
# 与 agent-gate gov_record 同语义，单行/多行 JSON 皆可。路径根为内置默认，
# 自定义目录根的仓库由 bootstrap transform_src 随装随改。
set -euo pipefail

# v3.93.0 (CHG-130, REQ-1298): change root is configurable
# (AGENT_GUARD_CHANGE_ROOT -> paths.change_root -> docs/changes); the old
# hardcoded docs/changes silently skipped every governance record elsewhere.
CHANGE_ROOT="${AGENT_GUARD_CHANGE_ROOT:-$(sed -nE 's/^[[:space:]]*change_root:[[:space:]]*([^#]*).*$/\1/p' .agent-governance.yml 2>/dev/null | head -1 | tr -d '[:space:]"' || true)}"
[[ -n "$CHANGE_ROOT" ]] || CHANGE_ROOT="docs/changes"

active=$(git rev-parse --git-path agent-governance/active-change 2>/dev/null || true)
if [[ -n "${active:-}" && -s "$active" && -f scripts/stamp-provenance.sh ]]; then
  id=$(tr -d '[:space:]' < "$active")
  if [[ -n "$id" ]]; then
    govs=$(ls "$CHANGE_ROOT"/*/00-governance.json "$CHANGE_ROOT"/BATCH-*/00-governance.json 2>/dev/null || true)
    refs=""
    for g in $govs; do
      rec=$(tr -d '\n\r' < "$g" 2>/dev/null | sed -E 's/\}[[:space:]]*,?[[:space:]]*\{/}\n{/g' \
        | grep "\"change_id\"[[:space:]]*:[[:space:]]*\"$id\"" | head -1 || true)
      [[ -n "$rec" ]] || continue
      refs="$refs $(printf '%s' "$rec" | sed -nE 's/.*"bug_ref"[[:space:]]*:[[:space:]]*"([A-Za-z0-9._-]+)".*/\1/p' || true)"
      refs="$refs $(printf '%s' "$rec" | sed -nE 's/.*"bug_ref"[[:space:]]*:[[:space:]]*\[([^]]*)\].*/\1/p' | tr -d '"' | tr ',' ' ' || true)"
    done
    echo "pre-commit: stamping provenance for $id (idempotent)"
    stamp_files="$(scripts/stamp-provenance.sh --all "$id" | awk '$1=="stamped"||$1=="trace-derive"{print $2}')"
    for b in $refs; do
      [[ "$b" =~ ^[A-Za-z0-9._-]+$ ]] || continue
      stamp_files="$stamp_files $(scripts/stamp-provenance.sh --bug "$b" | awk '$1=="stamped"||$1=="trace-derive"{print $2}')"
    done
    # 盖章回填（v3.61.2，REQ-1017）：index 剔章后与工作区剔章后相等才 git add——
    # 文件级精确 + hunk 级安全（git add -p 部分暂存不被盖写）；比较不等→跳过+警告
    # （fail-open，最坏=不回填=旧行为）；stamp 失败经 pipefail 仍阻断（fail-closed）。
    # v3.62.1（CHG-081/REQ-1026）：end 标记后空行全吞（旧版只吞 1 行）——章累积
    # 空行使迭代边界（index 已章 v1 vs 重盖 v2）恒失配、回填从未生效；归一后恢复。
    strip_awk='BEGIN{p="\x01"} /^<!-- trace-derive begin/||/^<!-- provenance$/{if(p!="\x01"&&p!="")print p;p="\x01";s=1;next} /^<!-- trace-derive end/||/^-->$/ {s=0;while((ng=(getline nxt))>0&&nxt~/^[[:space:]]*$/){};if(ng>0){if(p!="\x01")print p;p=nxt};next} s{next} {if(p!="\x01")print p;p=$0} END{if(p!="\x01")print p}'
    stamp_files=$(printf '%s\n' $stamp_files | sort -u)
    for f in $stamp_files; do
      [[ -f "$f" && -n "$(git ls-files -- "$f")" ]] || continue
      if [[ "$(git show ":$f" 2>/dev/null | awk "$strip_awk")" == "$(awk "$strip_awk" "$f")" ]]; then
        git add -- "$f"
      else
        echo "pre-commit: skip index backfill for $f (unstaged changes beyond stamp)" >&2
      fi
    done
  fi
fi

# v3.84.0 (CHG-111, REQ-1169): standalone defect batches — staged
# docs/bugs/BATCH-*/01-diagnosis.md anchors get stamped even when no active
# change binds them via bug_ref (previously fail-open; A21 only caught the
# gap after the commit landed). Top-level on purpose: independence from the
# active-change conditional above.
staged_diag=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^docs/bugs/BATCH-[^/]+/01-diagnosis\.md$' || true)
# v3.93.0 (CHG-130, REQ-1292): compare the provenance BLOCK content, not its
# count. Equal counts with a different timestamp/host/commit meant the index
# kept a stale block while this check reported "already stamped" (grep -c).
prov_block_from_index() { git show ":$1" 2>/dev/null | awk '/^<!-- provenance/{p=1} p{print} p&&/^-->/{exit}'; }
prov_block_from_tree() { awk '/^<!-- provenance/{p=1} p{print} p&&/^-->/{exit}' "$1"; }
for bf in $staged_diag; do
  for b in $(sed -nE 's/^##[[:space:]]+(BUG-[A-Za-z0-9._-]+).*/\1/p' "$bf" | sort -u); do
    [[ "$b" =~ ^[A-Za-z0-9._-]+$ ]] || continue
    if [[ -f scripts/stamp-provenance.sh ]]; then
      scripts/stamp-provenance.sh --bug "$b" >/dev/null 2>&1 || true
      if ! cmp -s <(prov_block_from_index "$bf") <(prov_block_from_tree "$bf"); then
        git add -- "$bf"
      fi
    fi
  done
done

# v3.71.0 (CHG-046, REQ-1090): 同变更换挡硬提醒（软提醒，不阻塞 commit；硬执法在
# agent-gate stop 的 GATE-E112）——last-delivery 指向的变更已交付且其目录无
# handoff.md 时大声提醒收尾必须换挡（E89 盲区：同变更长会话永不重跑 begin）。
lastd=.agent-state/last-delivery.json
if [[ -s "$lastd" ]]; then
  lchange=$(sed -n 's/.*"change"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$lastd" | head -1)
  if [[ -n "$lchange" && -d "$CHANGE_ROOT/$lchange" && ! -s "$CHANGE_ROOT/$lchange/handoff.md" ]]; then
    echo "pre-commit: SHIFT REMINDER: $lchange 已交付（.agent-state/last-delivery.json）且无 $CHANGE_ROOT/$lchange/handoff.md — 收尾必须写 handoff 文档并换挡新会话（§2.9.6 事件型换挡；确需继续，在 09 登记「换挡声明」；stop 侧 GATE-E112 会硬查）" >&2
  fi
fi

scripts/agent-gate --stage staged
